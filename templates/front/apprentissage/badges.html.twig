{% extends 'front/layout.html.twig' %}

{% block title %}Badges - Najahni{% endblock %}

{% block main %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-award me-2"></i>Badges</h2>
    <a href="{{ path('app_apprentissage_cours') }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Cours</a>
</div>

{# ===== STATS ===== #}
{% if badges|length > 0 %}
<div class="card border-0 shadow-sm p-3 mb-4" style="border-radius:1rem">
    <div class="d-flex gap-4 align-items-center">
        <div class="text-center">
            <div class="fs-4 fw-bold" style="color:var(--nj-primary)">{{ userBadges|length }}</div>
            <div class="small text-muted"><i class="bi bi-unlock me-1"></i>Débloqués</div>
        </div>
        <div class="vr"></div>
        <div class="text-center">
            <div class="fs-4 fw-bold text-muted">{{ badges|length - userBadges|length }}</div>
            <div class="small text-muted"><i class="bi bi-lock me-1"></i>Verrouillés</div>
        </div>
        <div class="vr"></div>
        <div class="flex-grow-1">
            <div class="d-flex justify-content-between small mb-1">
                <span>Progression</span>
                <span>{{ userBadges|length }}/{{ badges|length }}</span>
            </div>
            <div class="progress" style="height:8px;border-radius:1rem">
                <div class="progress-bar" style="width:{{ badges|length > 0 ? (userBadges|length / badges|length * 100)|round : 0 }}%;background:var(--nj-gradient)"></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    {% for badge in badges %}
    {% set unlocked = userBadges.contains(badge) %}
    <div class="col-md-4 col-lg-3">
        <div class="card border-0 shadow-sm h-100 text-center position-relative {{ unlocked ? '' : 'opacity-50' }}"
             style="border-radius:1rem; {{ unlocked ? 'border: 2px solid var(--nj-primary) !important' : '' }}">

            {# Badge statut coin #}
            {% if unlocked %}
            <span class="position-absolute top-0 end-0 m-2 badge bg-success">
                <i class="bi bi-check-lg me-1"></i>Débloqué
            </span>
            {% else %}
            <span class="position-absolute top-0 end-0 m-2 badge bg-secondary">
                <i class="bi bi-lock"></i>
            </span>
            {% endif %}

            <div class="card-body p-4">
                <div class="mb-3" style="font-size:3rem">
                    {% if unlocked %}
                        {{ badge.icone ?? '' }}
                    {% else %}
                        🔒
                    {% endif %}
                </div>
                <h5 class="fw-bold mb-1">{{ badge.nom }}</h5>
                <span class="badge mb-2 {{ badge.rarete == 'LEGENDAIRE' ? 'bg-warning text-dark' : (badge.rarete == 'EPIQUE' ? 'bg-danger' : (badge.rarete == 'RARE' ? 'bg-primary' : 'bg-secondary')) }}">
                    {{ badge.rarete }}
                </span>
                <p class="text-muted small mb-2">{{ badge.description }}</p>
                <div class="small text-muted">
                    {% if badge.pointsRequis %}<p class="mb-0"><i class="bi bi-star me-1"></i>{{ badge.pointsRequis }} XP requis</p>{% endif %}
                    {% if badge.coursRequis %}<p class="mb-0"><i class="bi bi-book me-1"></i>{{ badge.coursRequis }} cours requis</p>{% endif %}
                    {% if badge.niveauRequis %}<p class="mb-0"><i class="bi bi-bar-chart me-1"></i>Niveau {{ badge.niveauRequis }}</p>{% endif %}
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>

{% else %}
<div class="text-center py-5">
    <div class="text-center"><i class="bi bi-trophy" style="font-size:4rem;color:var(--nj-primary)"></i></div>
    <h4 class="fw-bold mt-3">Aucun badge disponible</h4>
</div>
{% endif %}
{% endblock %}