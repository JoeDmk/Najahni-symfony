{% extends 'front/layout.html.twig' %}

{% block title %}Chatbot Mentorat - Najahni{% endblock %}

{% block main %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-mortarboard me-2"></i>Mentorat</h2>
</div>

{# ── 4-Tab Navigation (role-aware) ── #}
{% set userRole = app.user.role %}
<ul class="nav nav-tabs mb-4">
    <li class="nav-item"><a class="nav-link" href="{{ path('app_mentorat_requests') }}"><i class="bi bi-send me-1"></i>Demandes</a></li>
    <li class="nav-item"><a class="nav-link" href="{{ path('app_mentorat_sessions') }}"><i class="bi bi-camera-video me-1"></i>Sessions</a></li>
    {% if userRole == 'MENTOR' %}
        <li class="nav-item"><a class="nav-link" href="{{ path('app_mentorat_availability') }}"><i class="bi bi-calendar-check me-1"></i>Disponibilités</a></li>
    {% endif %}
    <li class="nav-item"><a class="nav-link active" href="{{ path('app_mentorat_chatbot') }}"><i class="bi bi-robot me-1"></i>Chatbot</a></li>
</ul>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm" style="border-radius:1rem">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h5 class="fw-bold mb-0"><i class="bi bi-robot me-2"></i>Assistant Najahni</h5>
                <p class="text-muted small mb-0">Posez vos questions sur Najahni, le mentorat, les projets, l'investissement...</p>
                {% if not aiAvailable %}
                    <div class="alert alert-info small mt-3 mb-0">
                        L'assistant utilise une API AI si une clé est configurée. Sans clé, il répond avec des réponses prédéfinies sur Najahni.
                    </div>
                {% endif %}
            </div>
            <div class="card-body p-4">
                <div id="chatMessages" style="height:400px;overflow-y:auto;border:1px solid #e9ecef;border-radius:0.75rem;padding:1rem;background:#f8f9fa;" class="mb-3">
                    <div class="d-flex mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;min-width:32px;background:var(--nj-gradient);color:#fff"><i class="bi bi-robot"></i></div>
                        <div class="bg-white p-2 px-3 rounded-3 shadow-sm" style="max-width:80%">
                            <small>Bonjour {{ app.user.firstname }} ! 👋 Je suis l'assistant Najahni. Je connais tout sur la plateforme : mentorat, sessions, calendrier, projets, investissement, communauté et apprentissage. Comment puis-je vous aider ?</small>
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button class="btn btn-sm btn-outline-primary rounded-pill chatbot-suggestion" data-question="C'est quoi Najahni ?"><i class="bi bi-info-circle me-1"></i>C'est quoi Najahni ?</button>
                    <button class="btn btn-sm btn-outline-primary rounded-pill chatbot-suggestion" data-question="Comment trouver un mentor ?"><i class="bi bi-search me-1"></i>Trouver un mentor</button>
                    <button class="btn btn-sm btn-outline-primary rounded-pill chatbot-suggestion" data-question="Comment réserver une session ?"><i class="bi bi-calendar-check me-1"></i>Réserver une session</button>
                    <button class="btn btn-sm btn-outline-primary rounded-pill chatbot-suggestion" data-question="Qui sont les meilleurs mentors ?"><i class="bi bi-star me-1"></i>Meilleurs mentors</button>
                    <button class="btn btn-sm btn-outline-primary rounded-pill chatbot-suggestion" data-question="Comment fonctionne le matching ?"><i class="bi bi-lightning me-1"></i>Matching</button>
                    <button class="btn btn-sm btn-outline-primary rounded-pill chatbot-suggestion" data-question="Aide"><i class="bi bi-question-circle me-1"></i>Aide</button>
                </div>
                <div class="input-group">
                    <input type="text" id="chatInput" class="form-control" placeholder="Tapez votre message..." onkeypress="if(event.key==='Enter')sendMessage()">
                    <button class="btn btn-nj" onclick="sendMessage()"><i class="bi bi-send"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function sendMessage() {
    const input = document.getElementById('chatInput');
    const sendBtn = document.querySelector('.btn-nj');
    const text = input.value.trim();
    if (!text) return;

    input.value = '';
    input.disabled = true;
    if (sendBtn) {
        sendBtn.disabled = true;
    }

    appendMessage(text, 'user');
    const typingId = showTyping();

    fetch('{{ path('app_mentorat_chatbot_api') }}', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
        },
        body: JSON.stringify({ question: text }),
    })
    .then(response => response.json())
    .then(data => {
        removeTyping(typingId);
        appendMessage(data.answer || 'Désolé, aucune réponse disponible.', 'bot');
    })
    .catch(() => {
        removeTyping(typingId);
        appendMessage('Erreur de communication avec le serveur. Réessayez.', 'bot');
    })
    .finally(() => {
        input.disabled = false;
        if (sendBtn) {
            sendBtn.disabled = false;
        }
        input.focus();
    });
}

function appendMessage(text, sender) {
    const container = document.getElementById('chatMessages');
    const div = document.createElement('div');
    div.className = 'd-flex mb-3' + (sender === 'user' ? ' justify-content-end' : '');

    const formatted = escapeHtml(text).replace(/\n/g, '<br>');

    if (sender === 'bot') {
        div.innerHTML = '<div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;min-width:32px;background:var(--nj-gradient);color:#fff"><i class="bi bi-robot"></i></div>'
            + '<div class="bg-white p-2 px-3 rounded-3 shadow-sm" style="max-width:80%"><small>' + formatted + '</small></div>';
    } else {
        div.innerHTML = '<div class="p-2 px-3 rounded-3" style="max-width:80%;background:var(--nj-gradient);color:#fff"><small>' + formatted + '</small></div>';
    }

    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
}

function showTyping() {
    const container = document.getElementById('chatMessages');
    const div = document.createElement('div');
    const id = 'typing-' + Date.now();
    div.id = id;
    div.className = 'd-flex mb-3';
    div.innerHTML = '<div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;min-width:32px;background:var(--nj-gradient);color:#fff"><i class="bi bi-robot"></i></div>'
        + '<div class="bg-white p-2 px-3 rounded-3 shadow-sm"><small class="typing-dots"><span>.</span><span>.</span><span>.</span></small></div>';
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
    return id;
}

function removeTyping(id) {
    const el = document.getElementById(id);
    if (el) el.remove();
}

function escapeHtml(str) {
    var div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
}

// Quick-suggestion buttons
document.querySelectorAll('.chatbot-suggestion').forEach(function(btn) {
    btn.addEventListener('click', function() {
        document.getElementById('chatInput').value = this.dataset.question;
        sendMessage();
    });
});
</script>

<style>
.typing-dots span {
    animation: typingDot 1.4s infinite;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--nj-primary);
    font-weight: bold;
}
.typing-dots span:nth-child(2) { animation-delay: .2s; }
.typing-dots span:nth-child(3) { animation-delay: .4s; }
@keyframes typingDot {
    0%, 60%, 100% { opacity: .2; transform: translateY(0); }
    30% { opacity: 1; transform: translateY(-4px); }
}
</style>
{% endblock %}
